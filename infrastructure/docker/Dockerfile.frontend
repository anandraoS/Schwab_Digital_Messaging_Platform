# syntax=docker/dockerfile:1.7
# NOT executed on the authoring machine (no Docker). Statically reviewed only.
# Build context: repository root.  docker build -f infrastructure/docker/Dockerfile.frontend -t messaging-frontend:local .
# FROM node:22-alpine3.20 AS build
ARG NODE_IMAGE=node:22-alpine3.20
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /ui
COPY frontend/messaging-console/package.json frontend/messaging-console/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/messaging-console/ ./
RUN npx ng build --configuration production

FROM ${NGINX_IMAGE} AS runtime
USER root
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
# Angular 17+ application builder emits dist/<project>/browser
COPY --from=build /ui/dist/messaging-console/browser/ /usr/share/nginx/html/
RUN chown -R 101:101 /usr/share/nginx/html
USER 101
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
