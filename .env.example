# ALL VALUES BELOW ARE DUMMY, LOCAL-ONLY PLACEHOLDERS. Copy to `.env` and change if you like.
# Never reuse these anywhere real. `.env` is git-ignored.

# --- image tags / versions ---
IMAGE_TAG=local
BACKEND_PORT=18080
FRONTEND_PORT=14200

# --- PostgreSQL (superuser for init only; app uses least-privilege roles from init.sql) ---
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY_pg_admin
MESSAGING_APP_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY_pg_app
MESSAGING_MIGRATOR_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY_pg_migrator
MESSAGING_READONLY_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY_pg_readonly

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=messaging
RABBITMQ_DEFAULT_PASS=CHANGE_ME_LOCAL_ONLY_rabbit

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_LOCAL_ONLY_redis

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY_mongo_root
MONGO_APP_PASSWORD=CHANGE_ME_LOCAL_ONLY_mongo_app

# --- Backend ---
# Provider callback HMAC secret (dummy; CONTRACT section 1)
MESSAGING_CALLBACK_SECRETS_LOCAL_KEY=local-dev-secret-not-for-production
# prod-like needs an OIDC issuer. Compose default points at a placeholder; set a real IdP in real deployments.
JWT_ISSUER_URI=https://idp.example.test/realms/messaging

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY_grafana

# --- k6 (optional profile) ---
K6_BASE_URL=http://backend:18080
