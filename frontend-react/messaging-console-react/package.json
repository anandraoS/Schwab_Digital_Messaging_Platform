{
  "name": "messaging-console-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React operations console for the Schwab digital messaging platform (same backend and contract as the Angular console)",
  "scripts": {
    "dev": "vite --port 15200 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 15200 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
